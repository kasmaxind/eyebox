# ─────────────────────────────────────────────
# EYEBOX TUBE.AI — Environment Variables
# Copy to .env and fill in production values
# ─────────────────────────────────────────────

# App
NODE_ENV=development
APP_NAME=EYEBOX TUBE.AI
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/eyebox
MONGODB_URI_PROD=mongodb://mongo:27017/eyebox

# Redis
REDIS_URL=redis://localhost:6379
REDIS_URL_PROD=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=eyebox-tube-ai

# Cookies
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EYEBOX TUBE.AI <noreply@eyebox.ai>"

# OTP
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

# AWS S3 / CloudFront
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=eyebox-media
S3_ENDPOINT=
CLOUDFRONT_URL=
USE_LOCAL_STORAGE=true
LOCAL_UPLOAD_DIR=./uploads

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_QUALITIES=360,480,720,1080,1440,2160
THUMBNAIL_COUNT=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CSRF
CSRF_SECRET=change-me-csrf-secret-min-32-characters!

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:3000

# AI (optional — falls back to heuristic engine)
OPENAI_API_KEY=
AI_PROVIDER=heuristic

# Monetization (Stripe-ready)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PREMIUM_PRICE_MONTHLY=9.99
PREMIUM_PRICE_YEARLY=99.99

# Admin seed
ADMIN_EMAIL=admin@eyebox.ai
ADMIN_PASSWORD=Admin@Eyebox2026!
ADMIN_NAME=Eyebox Admin

# Logging
LOG_LEVEL=info
ENABLE_AUDIT_LOGS=true
